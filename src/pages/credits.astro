---
import BaseLayout from "@layouts/BaseLayout.astro";
import CreditSection from "@components/CreditSection.astro";
import { siteInfo } from "@i18n/ui";

const lang = "en";
---

<BaseLayout
  title={`Acknowledgements | ${siteInfo.englishName}`}
  description="A searchable directory of the people whose guidance, trust, and shared standards shaped this work."
  lang={lang}
  canonicalPath="/credits/"
>
  <CreditSection lang={lang} />
</BaseLayout>
