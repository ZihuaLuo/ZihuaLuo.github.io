---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import { siteInfo } from "@i18n/ui";

const lang = "en";
---

<BaseLayout
  title={`${siteInfo.englishName} | Finance, Research & Analytics`}
  description="Finance, research analytics, risk-aware thinking, and an archive of learning and reflection"
  lang={lang}
  canonicalPath="/"
>
  <Hero lang={lang} />
</BaseLayout>
