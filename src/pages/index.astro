---
import { withBase } from "@i18n/routes";

const aboutUrl = withBase("/about/");
const canonicalUrl = new URL(aboutUrl, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${aboutUrl}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalUrl} />
    <title>About | Zihua Luo</title>
    <script is:inline define:vars={{ aboutUrl }}>
      window.location.replace(aboutUrl);
    </script>
  </head>
  <body>
    <a href={aboutUrl}>Continue to About</a>
  </body>
</html>
