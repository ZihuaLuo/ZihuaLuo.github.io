---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import AboutNarrative from "@components/AboutNarrative.astro";
import { siteInfo } from "@i18n/ui";

const lang = "en";
---

<BaseLayout
  title={`${siteInfo.englishName} | Finance, Research & AI`}
  description="The personal website of Zihua Luo, FRM, featuring finance research, data dashboards, AI projects, and writing."
  lang={lang}
  canonicalPath="/"
  bodyClass="about-page"
>
  <Hero />
  <AboutNarrative lang={lang} />
</BaseLayout>
