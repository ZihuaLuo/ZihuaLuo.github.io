---
import WritingSeriesArchive from "@components/WritingSeriesArchive.astro";
import { essaysPerPage } from "@data/writingSeries";
import { getWritingSeriesArchives } from "@data/writingSeriesArchives";

export async function getStaticPaths() {
  const archives = await getWritingSeriesArchives();
  return archives.flatMap(({ entries, lang, series, totalCount, totalPages }) => {
    if (totalPages <= 1) {
      return [];
    }

    return Array.from({ length: totalPages - 1 }, (_, index) => {
      const currentPage = index + 2;
      const start = (currentPage - 1) * essaysPerPage;

      return {
        params: {
          page: String(currentPage),
          series: series.slug,
        },
        props: {
          currentPage,
          entries: entries.slice(start, start + essaysPerPage),
          lang,
          series,
          totalCount,
          totalPages,
        },
      };
    });
  });
}
---

<WritingSeriesArchive {...Astro.props} />
