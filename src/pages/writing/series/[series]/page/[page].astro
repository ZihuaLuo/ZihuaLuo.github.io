---
import { getCollection } from "astro:content";
import WritingSeriesArchive from "@components/WritingSeriesArchive.astro";
import { essaysPerPage, writingSeries } from "@data/writingSeries";

export async function getStaticPaths() {
  const lang = "en" as const;
  const includeDrafts = !import.meta.env.PROD;
  const allWriting = await getCollection(
    "writing",
    ({ data }) => data.language === lang && (includeDrafts || !data.draft),
  );

  return writingSeries.flatMap((series) => {
    const entries = allWriting
      .filter((entry) => entry.data.category === series.category)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    const totalPages = Math.ceil(entries.length / essaysPerPage);

    if (totalPages <= 1) {
      return [];
    }

    return Array.from({ length: totalPages - 1 }, (_, index) => {
      const currentPage = index + 2;
      const start = (currentPage - 1) * essaysPerPage;

      return {
        params: {
          page: String(currentPage),
          series: series.slug,
        },
        props: {
          currentPage,
          entries: entries.slice(start, start + essaysPerPage),
          lang,
          series,
          totalCount: entries.length,
          totalPages,
        },
      };
    });
  });
}
---

<WritingSeriesArchive {...Astro.props} />
