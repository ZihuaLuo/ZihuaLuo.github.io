---
import { getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import { entrySlug } from "@i18n/routes";

export async function getStaticPaths() {
  const includeDrafts = !import.meta.env.PROD;
  const entries = await getCollection(
    "writing",
    ({ data }) => data.language === "en" && (includeDrafts || !data.draft),
  );

  return entries.map((entry) => {
    const slug = entrySlug(entry.id);

    return {
      params: { slug },
      props: {
        entry,
        canonicalPath: `/writing/${slug}/`,
      },
    };
  });
}

const { entry, canonicalPath } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  entry={entry}
  lang="en"
  canonicalPath={canonicalPath}
>
  <Content />
</ContentLayout>
