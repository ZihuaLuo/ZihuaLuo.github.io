---
import type { Language } from "@i18n/routes";

interface Props {
  lang: Language;
}

const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t border-white/[0.12] bg-[linear-gradient(180deg,rgba(var(--rgb-bg-base),0.58),rgba(var(--rgb-bg-deep),0.66))] shadow-[0_-20px_80px_rgba(56,189,248,0.08),0_-10px_42px_rgba(124,58,237,0.08)] backdrop-blur-2xl"
  aria-label="Footer"
>
  <div class="container-page py-6 text-center text-sm text-muted">
    <span>&copy; {year} Zihua Luo</span>
  </div>
</footer>
