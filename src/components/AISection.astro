---
import FutureChat from "./ai/FutureChat.astro";
import ParticleNetwork from "./ai/ParticleNetwork.astro";
import AILabShowcase from "./ai/AILabShowcase.astro";
---

<section id="ai" class="ai-future" aria-labelledby="ai-future-title" data-ai-future>
  <ParticleNetwork />

  <div class="ai-future__ambient" aria-hidden="true">
    <span class="ai-future__glow ai-future__glow--blue"></span>
    <span class="ai-future__glow ai-future__glow--violet"></span>
    <span class="ai-future__arc"></span>
  </div>

  <div class="container-page ai-future__layout">
    <header class="ai-future__intro">
      <h1 id="ai-future-title" class="display-heading">
        <span data-future-reveal style="--reveal-delay: 170ms;">Welcome to</span>
        <span class="ai-future__title-gradient" data-future-reveal style="--reveal-delay: 270ms;">
          the Future
        </span>
      </h1>

      <p class="ai-future__lede" data-future-reveal style="--reveal-delay: 350ms;">
        Applied AI, research systems, and analytical tools built around real financial and human questions.
      </p>

      <div>
        <AILabShowcase />
      </div>

    </header>

    <div class="ai-future__console" data-future-reveal style="--reveal-delay: 230ms;">
      <FutureChat />
    </div>
  </div>
</section>

<script>
  type AIFutureWindow = Window & { __aiFuturePageLoad?: () => void };

  const initializeAIFuture = () => {
    const section = document.querySelector<HTMLElement>("[data-ai-future]");
    if (!section || section.dataset.futureReady === "true") return;
    section.dataset.futureReady = "true";

    let hasVisited = true;
    try {
      hasVisited = sessionStorage.getItem("zihua-ai-future-seen") === "true";
      sessionStorage.setItem("zihua-ai-future-seen", "true");
    } catch {
      hasVisited = true;
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!hasVisited && !reduceMotion) section.classList.add("is-first-visit");
    requestAnimationFrame(() => section.classList.add("is-ready"));
  };

  const futureWindow = window as AIFutureWindow;
  if (futureWindow.__aiFuturePageLoad) {
    document.removeEventListener("astro:page-load", futureWindow.__aiFuturePageLoad);
  }
  futureWindow.__aiFuturePageLoad = initializeAIFuture;
  document.addEventListener("astro:page-load", initializeAIFuture);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAIFuture, { once: true });
  } else {
    initializeAIFuture();
  }
</script>

<style>
  .ai-future {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - 78px);
    align-items: center;
    overflow: hidden;
    padding-block: clamp(1.25rem, 2.5vw, 2.5rem) clamp(3.5rem, 6vw, 6.5rem);
    color: #f8fafc;
    background:
      radial-gradient(ellipse 52% 48% at 78% 42%, rgba(59, 130, 246, 0.08), transparent 72%),
      linear-gradient(145deg, #050816 0%, #070a19 46%, #090d1f 100%);
  }

  .ai-future::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(rgba(248, 250, 252, 0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 250, 252, 0.012) 1px, transparent 1px);
    background-size: 96px 96px;
    content: "";
    mask-image: radial-gradient(ellipse at 70% 48%, #000 0%, transparent 76%);
    pointer-events: none;
  }

  .ai-future__layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(26rem, 1.08fr);
    align-items: start;
    gap: clamp(3rem, 6vw, 7rem);
    transform: translateY(-0.9rem);
  }

  .ai-future__intro {
    position: relative;
    min-width: 0;
    max-width: 46rem;
  }

  .ai-future h1 {
    margin-top: 0;
    font-size: clamp(3.75rem, 4.75vw, 5.75rem);
    font-weight: 600;
    letter-spacing: -0.047em;
    line-height: 0.98;
  }
  .ai-future h1 > span {
    display: block;
    white-space: nowrap;
  }
  .ai-future__title-gradient {
    margin-top: 0.16em;
    padding-bottom: 0.09em;
    color: #f8fafc;
    background: linear-gradient(102deg, #f8fafc 4%, #c7e9ff 48%, #a78bfa 96%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ai-future__lede {
    width: min(100%, 34rem);
    margin-top: 1.1rem;
    color: rgba(203, 213, 225, 0.72);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .ai-future__console { min-width: 0; width: 100%; max-width: 48rem; justify-self: end; }

  .ai-future__ambient,
  .ai-future__glow,
  .ai-future__arc { position: absolute; pointer-events: none; }
  .ai-future__ambient { inset: 0; z-index: 1; overflow: hidden; }
  .ai-future__glow { border-radius: 50%; filter: blur(70px); }
  .ai-future__glow--blue {
    top: 6%; right: 5%; width: 28rem; height: 28rem;
    background: rgba(59, 130, 246, 0.075);
  }
  .ai-future__glow--violet {
    right: -7rem; bottom: -10rem; width: 24rem; height: 24rem;
    background: rgba(124, 58, 237, 0.055);
  }
  .ai-future__arc {
    top: 50%; right: -24rem; width: 60rem; height: 38rem;
    border: 1px solid rgba(167, 139, 250, 0.045);
    border-radius: 50%;
    transform: translateY(-50%) rotate(-11deg);
  }

  .is-first-visit [data-future-reveal] { opacity: 0; transform: translateY(0.85rem); }
  .is-first-visit .ai-future__console[data-future-reveal] { transform: translate(1.1rem, 0.75rem); }
  .is-first-visit.is-ready [data-future-reveal] {
    opacity: 1;
    transform: none;
    transition:
      opacity 460ms ease var(--reveal-delay, 0ms),
      transform 560ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
  }
  @media (max-width: 1040px) {
    .ai-future { min-height: auto; }
    .ai-future__layout { grid-template-columns: 1fr; }
    .ai-future__intro { max-width: 48rem; }
    .ai-future__console { max-width: 52rem; justify-self: stretch; }
    .ai-future h1 { font-size: clamp(3.65rem, 9.6vw, 5.85rem); }
  }

  @media (max-width: 640px) {
    .ai-future { padding-block: 6.25rem 4.5rem; }
    .ai-future__layout { gap: 3.5rem; }
    .ai-future h1 { font-size: clamp(3rem, 13.2vw, 4rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-future [data-future-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
