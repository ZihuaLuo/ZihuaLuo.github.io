---
import { withBase, type Language } from "@i18n/routes";
import { siteInfo } from "@i18n/ui";
import TheCutLogo from "./TheCutLogo.astro";

interface Props {
  lang: Language;
}

const alt = "Portrait of Zihua Luo";
---

<aside class="portrait-system relative mx-auto w-full max-w-[340px] sm:max-w-[390px]" aria-label="Profile photo">
  <div class="portrait-frame relative rounded-[1.35rem] border border-white/[0.16] bg-white/[0.045] p-2.5">
    <div class="relative overflow-hidden rounded-[1rem] border border-white/[0.12] bg-[var(--bg-deep)]">
      <div class="relative aspect-[4/5]" data-portrait>
        <img
          class="h-full w-full object-cover object-center"
          src={withBase(siteInfo.profilePhoto)}
          alt={alt}
          loading="eager"
          onerror="this.setAttribute('hidden', ''); this.nextElementSibling?.classList.remove('hidden');"
        />
        <div class="hidden grid h-full place-items-center bg-gradient-to-br from-elevated to-paper px-8 text-center text-ink">
          <div class="mx-auto grid h-24 w-24 place-items-center">
            <TheCutLogo size="100%" />
          </div>
        </div>
      </div>
    </div>

  </div>
</aside>

<style>
  .portrait-frame {
    box-shadow: none;
  }
</style>
