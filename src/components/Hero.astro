---
import { withBase, type Language } from "@i18n/routes";

interface Props {
  lang: Language;
}

const copy = {
  eyebrow: "Welcome to my personal website",
  name: "Zihua Luo, FRM",
  fields: ["Finance", "Research", "AI"],
  description: [
    "Hi, I’m Zihua. My interests sit at the intersection of finance, research, and AI.",
    "I enjoy asking better questions, making sense of complex problems, and turning what I learn into something useful. This site is a collection of the work, ideas, and experiences that are shaping how I think.",
  ],
  experienceCta: "View Experience",
  writingCta: "Read My Writing",
  scrollCue: "A little more about me",
};

---

<section id="about" class="finance-hero hero-entry">
  <div class="container-page hero-entry__inner relative z-10">
    <div class="hero-entry__copy text-ink">
      <p class="hero-entry__welcome-title">{copy.eyebrow}</p>
      <h1 class="display-heading title-flow hero-entry__title">
        {copy.name}
      </h1>

      <p class="hero-entry__tagline" aria-label="Finance, Research, and AI">
        {copy.fields.map((field, index) => (
          <>
            <span class:list={{ "hero-entry__tagline-field--ai": field === "AI" }}>{field}</span>
            {index < copy.fields.length - 1 && <span class="hero-entry__tagline-dot" aria-hidden="true">•</span>}
          </>
        ))}
      </p>

      <div class="hero-entry__description">
        {copy.description.map((sentence, index) => (
          <p class:list={{ "hero-entry__description-lead": index === 0 }}>{sentence}</p>
        ))}
      </div>

      <div class="hero-entry__actions" aria-label="About page introductions">
        <a class="hero-entry__cta hero-entry__cta--primary" href={withBase("/experience/")}>
          <span>{copy.experienceCta}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="hero-entry__cta hero-entry__cta--secondary" href={withBase("/writing/")}>
          <span>{copy.writingCta}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>

  <a class="hero-entry__scroll-cue" href="#about-story-title">
    <span>{copy.scrollCue}</span>
    <span class="hero-entry__scroll-arrow" aria-hidden="true">↓</span>
  </a>
</section>

<style is:global>
  #about.finance-hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 78px);
    flex-direction: column;
    justify-content: flex-start;
    border-bottom: 0;
    padding: clamp(1.2rem, 2.4vh, 2rem) 0 1rem;
    background:
      radial-gradient(ellipse 68% 62% at 50% 43%, transparent 20%, rgba(var(--rgb-bg-deep), 0.16) 100%),
      linear-gradient(180deg, rgba(var(--rgb-bg-base), 0.24) 0%, rgba(var(--rgb-bg-deep), 0.12) 48%, rgba(var(--rgb-bg-deep), 0.56) 100%),
      url("/images/hero-celestial-horizon-v10.webp") center -3rem / 100% calc(100% + 7rem) no-repeat;
    box-shadow: none;
    isolation: isolate;
    overflow: hidden;
  }

  #about.finance-hero::before {
    display: none;
  }

  #about.finance-hero::after {
    position: absolute;
    inset: auto 0 -1px;
    z-index: 2;
    display: block;
    height: clamp(9rem, 18vh, 13rem);
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(var(--rgb-bg-base), 0.18) 24%,
      rgba(var(--rgb-bg-base), 0.52) 56%,
      rgba(var(--rgb-bg-base), 0.88) 82%,
      rgb(var(--rgb-bg-base)) 100%
    );
    content: "";
    filter: none;
    opacity: 1;
    pointer-events: none;
  }

  .hero-entry__welcome-title {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    font-weight: 850;
    letter-spacing: 0.2em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-entry__inner {
    display: grid;
    flex: 1;
    align-content: center;
    align-items: center;
    justify-items: center;
    gap: clamp(2.4rem, 5vw, 5rem);
    padding-block: clamp(1.4rem, 2.8vh, 2.4rem);
  }

  .hero-entry__copy {
    min-width: 0;
    width: min(100%, 52rem);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero-entry__title {
    margin: 0;
    max-width: none;
    color: transparent;
    font-size: clamp(4rem, 5.2vw, 5.75rem);
    font-weight: 600;
    filter: none;
    line-height: 0.98;
    text-shadow: none;
    white-space: nowrap;
  }

  .hero-entry__title.title-flow {
    filter: none;
    text-shadow: none;
  }

  .hero-entry__tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    max-width: 48rem;
    margin: 1.55rem auto 0;
    color: var(--muted);
    font-size: clamp(1.06rem, 1.45vw, 1.24rem);
    font-weight: 780;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-entry__tagline-dot {
    color: var(--accent);
    font-size: 0.78em;
    text-shadow: 0 0 8px rgba(var(--rgb-cyan), 0.1);
  }

  .hero-entry__tagline-field--ai {
    color: color-mix(in srgb, var(--muted) 75%, var(--accent) 25%);
    text-shadow: none;
  }

  .hero-entry__description {
    max-width: 52rem;
    margin: 2.25rem auto 0;
    color: var(--body);
    font-size: clamp(1.02rem, 1.3vw, 1.12rem);
    line-height: 2;
  }

  .hero-entry__description p {
    margin: 0;
  }

  .hero-entry__description p + p {
    max-width: 42.5rem;
    margin-inline: auto;
    margin-top: 1.15rem;
  }

  .hero-entry__description-lead {
    max-width: none;
    color: var(--body-soft);
    font-size: clamp(1.1rem, 1.25vw, 1.18rem);
    font-weight: 650;
    line-height: 1.65;
  }

  @media (min-width: 900px) {
    .hero-entry__description-lead {
      white-space: nowrap;
    }
  }

  .hero-entry__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.95rem;
    margin-top: 1.45rem;
  }

  .hero-entry__cta {
    display: inline-grid;
    min-width: 11.25rem;
    height: 2.875rem;
    grid-template-columns: minmax(0, 1fr) 2.625rem;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 13px;
    padding: 0 0 0 0.95rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: border-color 200ms ease, background 200ms ease, transform 200ms ease;
  }

  .hero-entry__cta > span:first-child {
    padding-right: 0.85rem;
    text-align: center;
  }

  .hero-entry__cta > span:last-child {
    display: grid;
    min-width: 2.625rem;
    height: 100%;
    place-items: center;
    border-left: 1px solid rgba(181, 199, 224, 0.1);
    color: rgba(232, 239, 250, 0.84);
    transition: background 200ms ease, color 200ms ease, transform 200ms ease;
  }

  .hero-entry__cta--primary {
    background:
      linear-gradient(rgba(var(--rgb-bg-deep), 0.86), rgba(var(--rgb-bg-deep), 0.86)) padding-box,
      linear-gradient(120deg, rgba(var(--rgb-cyan-soft), 0.4), rgba(var(--rgb-violet-soft), 0.34)) border-box;
  }

  .hero-entry__cta--primary > span:last-child {
    border-left-color: rgba(var(--rgb-violet-soft), 0.13);
    background: linear-gradient(135deg, rgba(var(--rgb-cyan-soft), 0.045), rgba(var(--rgb-violet-soft), 0.085));
    color: color-mix(in srgb, var(--ink) 82%, rgb(var(--rgb-violet-soft)) 18%);
  }

  .hero-entry__cta--secondary {
    border-color: rgba(174, 193, 218, 0.18);
    background: rgba(var(--rgb-bg-deep), 0.66);
  }

  .hero-entry__cta--secondary > span:last-child {
    border-left-color: rgba(174, 193, 218, 0.09);
    background: rgba(174, 193, 218, 0.035);
  }

  .hero-entry__cta:hover {
    transform: translateY(-2px);
  }

  .hero-entry__cta:hover > span:last-child {
    transform: translateX(3px);
  }

  .hero-entry__cta--primary:hover {
    background:
      linear-gradient(rgba(var(--rgb-bg-deep), 0.84), rgba(var(--rgb-bg-deep), 0.84)) padding-box,
      linear-gradient(120deg, rgba(var(--rgb-cyan-soft), 0.54), rgba(var(--rgb-violet-soft), 0.46)) border-box;
  }

  .hero-entry__cta--secondary:hover {
    border-color: rgba(184, 202, 226, 0.28);
  }

  .hero-entry__scroll-cue {
    position: relative;
    z-index: 10;
    display: inline-flex;
    width: fit-content;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    margin: 0.3rem auto 0;
    padding: 0.35rem 0.8rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 680;
    letter-spacing: 0.055em;
    opacity: 0.7;
    text-align: center;
    transition: color 220ms ease, opacity 220ms ease;
  }

  .hero-entry__scroll-cue:hover {
    color: var(--accent);
    opacity: 1;
  }

  .hero-entry__scroll-arrow {
    color: rgba(var(--rgb-cyan-soft), 0.68);
    font-size: 1rem;
  }

  @media (min-width: 1024px) {
    .hero-entry__copy {
      transform: translateY(-2.75rem);
    }

    .hero-entry__scroll-cue {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      margin: 0;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1280px) {
    .hero-entry__actions {
      position: static;
      width: auto;
      flex-direction: row;
      align-items: center;
      margin-top: 1.45rem;
      transform: none;
    }

    .hero-entry__cta {
      min-width: 11.25rem;
    }
  }

  @media (min-width: 1800px) {
    #about.finance-hero {
      background:
        radial-gradient(ellipse 68% 62% at 50% 43%, transparent 20%, rgba(var(--rgb-bg-deep), 0.16) 100%),
        linear-gradient(180deg, rgba(var(--rgb-bg-base), 0.24) 0%, rgba(var(--rgb-bg-deep), 0.12) 48%, rgba(var(--rgb-bg-deep), 0.56) 100%),
        url("/images/hero-celestial-horizon-v10.webp") center -5rem / 100% calc(100% + 9rem) no-repeat;
    }
  }

  @media (max-width: 1023px) {
    #about.finance-hero {
      min-height: auto;
      padding-top: 1.8rem;
      background:
        linear-gradient(180deg, rgba(var(--rgb-bg-deep), 0.64) 0%, rgba(var(--rgb-bg-deep), 0.5) 58%, rgba(var(--rgb-bg-deep), 0.74) 100%),
        url("/images/hero-celestial-horizon-v10.webp") center / cover no-repeat;
    }

    .hero-entry__welcome-title {
      font-size: clamp(0.875rem, 1.9vw, 1rem);
    }

    .hero-entry__copy {
      width: min(100%, 52rem);
      margin-inline: auto;
      text-align: center;
    }

  }

  @media (max-width: 639px) {
    #about.finance-hero {
      padding-top: 1.35rem;
      background:
        linear-gradient(180deg, rgba(var(--rgb-bg-deep), 0.66) 0%, rgba(var(--rgb-bg-deep), 0.54) 58%, rgba(var(--rgb-bg-deep), 0.76) 100%),
        url("/images/hero-celestial-horizon-v10.webp") center / cover no-repeat;
    }

    .hero-entry__welcome-title {
      font-size: 0.875rem;
      letter-spacing: 0.18em;
      line-height: 1.35;
    }

    .hero-entry__inner {
      gap: 2.25rem;
      padding-block: 1.35rem 1.15rem;
    }

    .hero-entry__title {
      font-size: clamp(2rem, 9vw, 2.4rem);
      letter-spacing: -0.015em;
    }

    .hero-entry__tagline {
      margin-top: 1.1rem;
      gap: 0.38rem;
      font-size: 1rem;
      letter-spacing: 0.1em;
    }

    .hero-entry__description {
      margin-top: 1.35rem;
      font-size: 0.98rem;
      line-height: 1.75;
    }

    .hero-entry__description-lead {
      font-size: 1.08rem;
      line-height: 1.55;
    }

    .hero-entry__description p + p {
      margin-top: 0.7rem;
    }

    .hero-entry__actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 1.2rem;
    }

    .hero-entry__cta {
      width: 100%;
    }

  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-entry__scroll-arrow {
      animation: hero-scroll-cue 1.9s ease-in-out infinite;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-entry__cta,
    .hero-entry__scroll-cue,
    .hero-entry__scroll-arrow {
      animation: none !important;
      transition: none !important;
    }
  }

  @keyframes hero-scroll-cue {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

</style>
