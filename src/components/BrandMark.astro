---
import TheCutLogo from "./TheCutLogo.astro";

interface Props {
  label?: string;
  dark?: boolean;
  size?: "sm" | "md" | "lg";
  decorative?: boolean;
}

const { label = "The Cut logo", dark = false, size = "md", decorative = false } = Astro.props;
const sizeClass = {
  sm: "h-10 w-10",
  md: "h-12 w-12",
  lg: "h-14 w-14",
}[size];
---

<span
  class={`brand-mark ${sizeClass} ${dark ? "brand-mark-dark" : ""}`}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  role={decorative ? undefined : "img"}
>
  <TheCutLogo size="100%" decorative />
</span>
