---
import BaseLayout from "@layouts/BaseLayout.astro";
import Tag from "@components/Tag.astro";
import ReadingPreferences from "@components/ReadingPreferences.astro";
import { entryDateTime, formatEntryDate, readingTime, withBase, type Language } from "@i18n/routes";
import { siteInfo, ui } from "@i18n/ui";

interface Props {
  entry: any;
  lang: Language;
  canonicalPath: string;
}

const { entry, lang, canonicalPath } = Astro.props;
const backLabel = ui[lang].backToWriting;
const backHref = withBase("/writing/");
const authorName = siteInfo.englishName;
const pageTitle = `${entry.data.title} | ${authorName}`;
const minutes = readingTime(entry.body ?? "");
const featuredLabel = "Featured Essay";
const displayDate = formatEntryDate(entry.data);
const dateTime = entryDateTime(entry.data);
---

<BaseLayout
  title={pageTitle}
  description={entry.data.description}
  lang={lang}
  canonicalPath={canonicalPath}
  type="article"
>
  <article data-reading-article data-reading-mode="dark">
    <header class="finance-shell py-14 sm:py-20">
      <div class="container-page relative z-10">
        <a
          class="mb-8 inline-flex rounded-full border border-line bg-white/[0.06] px-3 py-1.5 text-sm font-bold text-ink shadow-card transition hover:-translate-y-0.5 hover:border-accent/60 hover:bg-white/[0.1]"
          href={backHref}
        >
          <span aria-hidden="true">←</span>
          <span class="ml-2">{backLabel}</span>
        </a>
        <div class="max-w-3xl">
          <div class="mb-5 flex flex-wrap items-center gap-2 text-sm text-muted">
            <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 text-xs font-bold text-ink">
              {entry.data.category}
            </span>
            {entry.data.featured && (
              <span class="rounded-full border border-gold/45 bg-gold/15 px-2.5 py-1 text-xs font-extrabold text-gold">
                {featuredLabel}
              </span>
            )}
            <time datetime={dateTime}>{displayDate}</time>
            <span aria-hidden="true">/</span>
            <span>{minutes}</span>
          </div>
          <h1 class="display-heading text-4xl font-semibold leading-[1.02] text-ink sm:text-5xl lg:text-6xl">{entry.data.title}</h1>
          <div class="mt-6 flex flex-wrap gap-2">
            {entry.data.tags.map((tag: string) => <Tag label={tag} />)}
          </div>
        </div>
      </div>
    </header>

    <div class="container-page relative z-10 mt-[-24px] grid gap-10 pb-16 lg:grid-cols-[minmax(0,760px)_1fr]">
      <div class="min-w-0">
        <ReadingPreferences />
        <div class="prose-article premium-card rounded-2xl p-6 sm:p-9">
          <slot />
        </div>
        <slot name="continuation" />
      </div>
      <aside class="hidden lg:block">
        <div class="premium-card sticky top-28 rounded-2xl p-5 text-sm leading-7 text-muted">
          <p class="font-bold text-ink">{authorName}</p>
          <p class="mt-4">
            A record from a long-term personal archive focused on learning, judgment, and structured growth.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-article { overflow-wrap: anywhere; }
  [data-reading-mode="light"] .prose-article {
    color-scheme: light;
    --body: #253342;
    --ink: #122232;
    --body-soft: #34495e;
    --muted: #536373;
    --soft: #1e3845;
    --line: #d6dce0;
    --accent: #065e73;
    --violet: #5b5293;
    --rgb-violet-soft: 87, 73, 125;
    --bg-code: #e8edf0;
    --background-card: #fbfaf6;
    --border-glow: #d6dce0;
    --shadow-card: 0 8px 24px rgba(0,0,0,0.12);
  }
  [data-reading-mode="light"] .prose-article::before,
  [data-reading-mode="light"] .prose-article::after { display: none; }
  [data-reading-mode="light"] .prose-article :global(a) { color: var(--accent); text-decoration: underline; }
</style>
